{
  "expo": {
    "name": "Galingtosh",
    "slug": "galingtosh",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.danproduction.galingtosh",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#080611"
      }
    },
    "extra": {},
    "scheme": "galingtosh",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Galingtosh utilise les médias que vous choisissez pour vos projets.",
          "cameraPermission": "Autoriser Galingtosh à prendre des médias pour vos projets."
        }
      ],
      "expo-document-picker"
    ]
  }
}