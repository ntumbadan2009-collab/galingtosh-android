{
  "expo": {
    "name": "Galingtosh",
    "slug": "galingtosh",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "galingtosh",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.galingtosh.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#080711"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Galingtosh a besoin d'accéder aux médias que vous choisissez pour vos productions.",
          "cameraPermission": "Galingtosh a besoin de la caméra uniquement lorsque vous choisissez de capturer un média."
        }
      ]
    ]
  }
}